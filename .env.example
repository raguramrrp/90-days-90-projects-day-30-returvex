# RETURVEX Configuration Environment
PROJECT_NAME=RETURVEX
PROJECT_TITLE="E-Commerce Returns Intelligence & Profit Recovery Platform"
TAGLINE="Turn return data into smarter business decisions."
VERSION=1.0.0

# Database Connection (Defaults to zero-config SQLite, PostgreSQL ready)
DATABASE_URL=sqlite:///./returvex.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/returvex

# Accounting & Cost Parameters (INR)
DEFAULT_CURRENCY_SYMBOL=₹
DEFAULT_REVERSE_LOGISTICS_FEE=120.0
DEFAULT_RESTOCKING_PERCENT=0.05
DEFAULT_WRITE_OFF_PERCENT=0.15
DEFAULT_RECOVERABLE_PERCENT=0.80

# Return Risk Classification Thresholds (% return rate)
RISK_THRESHOLD_LOW=8.0
RISK_THRESHOLD_MODERATE=15.0
RISK_THRESHOLD_HIGH=25.0
